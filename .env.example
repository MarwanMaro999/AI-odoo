# Groq is the only AI provider used by Datum Engine.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_COMPLETION_TOKENS=4096
GROQ_TIMEOUT_SECONDS=90
GROQ_RESEARCH_MODEL=groq/compound

# Odoo connection. These settings are reserved for the later Odoo integration.
ODOO_BASE_URL=http://localhost:8070
ODOO_DB=
ODOO_API_KEY=

# Absolute path to the externally managed skill registry.
REGISTRY_PATH=C:\path\outside\the\repository\datum-engine-registry

# Local asynchronous runtime. No PostgreSQL or Redis is required.
LOG_LEVEL=INFO
WORKER_CONCURRENCY=2
DEV_OUTPUT_DIR=./.runtime/outputs
ENGINE_STATE_DIR=./.runtime/engine-state
ENGINE_OUTPUT_DIR=./.runtime/engine-outputs
ENGINE_DEMO_REGISTRY_PATH=C:\\ProgramData\\OdooTec\\datum-engine-registry
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_FILES=5
RUN_MAX_ATTEMPTS=3
REVIEW_LOOP_MAX_CYCLES=5
