# Groq is the only AI provider used by Datum Engine.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RESEARCH_MODEL=groq/compound

# Odoo connection. These settings are reserved for the later Odoo integration.
ODOO_BASE_URL=http://localhost:8070
ODOO_DB=
ODOO_API_KEY=

# Inbound authentication is deferred until the questionnaire logic is approved.
API_AUTH_TOKEN=

# Absolute path to the externally managed questionnaire registry.
REGISTRY_PATH=C:\path\outside\the\repository\datum-engine-registry

# Development runtime settings.
LOG_LEVEL=INFO
WORKER_CONCURRENCY=2
DEV_OUTPUT_DIR=./.runtime/outputs
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_FILES=5
RUN_MAX_ATTEMPTS=3
REVIEW_LOOP_MAX_CYCLES=5
