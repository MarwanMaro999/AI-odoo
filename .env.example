# Cloud providers. Keep all real keys only in .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_PROVIDER_ORDER=gemini,groq

# Web research providers. Groq Compound is a research fallback, not the generator.
TAVILY_API_KEY=
GROQ_RESEARCH_MODEL=groq/compound
SEARCH_PROVIDER_ORDER=tavily,groq_compound

# Absolute path to the externally managed skill registry. It must not be stored in Git.
REGISTRY_PATH=C:\\path\\outside\\the\\repository\\datum-engine-registry

# Development-only runtime settings.
WORKER_CONCURRENCY=2
DEV_OUTPUT_DIR=./.runtime/outputs
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_FILES=5
RUN_MAX_ATTEMPTS=3
