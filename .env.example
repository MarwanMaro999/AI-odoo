# Groq is the production primary. Hugging Face Llama is attempted only after a
# Groq failure; no Gemini or Qwen runtime path is configured.
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_COMPLETION_TOKENS=4096
GROQ_TIMEOUT_SECONDS=90
GROQ_RESEARCH_MODEL=groq/compound
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_PROVIDER=auto
HF_AUTOMATIC_FALLBACK_ENABLED=false
HF_MAX_COMPLETION_TOKENS=2000
HF_TIMEOUT_SECONDS=90
# Neon PostgreSQL connection used for durable sessions, jobs, reviews, and
# clarifications. Never commit a real value.
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# GPT-OSS is primary; Compound is an independently budgeted fallback.
AI_GENERATION_MODEL=qwen/qwen3.8-27b
AI_GENERATION_ENABLED=true
AI_GENERATION_SOURCE_BYTES=14000
AI_GENERATION_MAX_INPUT_TOKENS=7000
AI_GENERATION_MAX_OUTPUT_TOKENS=2000
AI_GENERATION_RPM=30
AI_GENERATION_TPM=8000
AI_GENERATION_RPD=1000
AI_GENERATION_TIMEOUT_SECONDS=90
AI_GENERATION_MAX_RETRIES=2
AI_GENERATION_FALLBACK_ENABLED=true
AI_GENERATION_FALLBACK_MODEL=qwen/qwen3.6-27b
AI_GENERATION_FALLBACK_SOURCE_BYTES=8000
AI_GENERATION_FALLBACK_MAX_INPUT_TOKENS=4000
AI_GENERATION_FALLBACK_MAX_OUTPUT_TOKENS=1500
AI_GENERATION_FALLBACK_RPM=30
AI_GENERATION_FALLBACK_TPM=8000
AI_GENERATION_FALLBACK_RPD=1000
AI_GENERATION_FALLBACK_TIMEOUT_SECONDS=90
AI_GENERATION_FALLBACK_MAX_RETRIES=1
# Local HF fallback caps (not provider quota claims; HF auto routing is dynamic).
HF_FALLBACK_SOURCE_BYTES=12000
HF_FALLBACK_MAX_INPUT_TOKENS=6000
HF_FALLBACK_RPM=5
HF_FALLBACK_TPM=40000
HF_FALLBACK_RPD=100
HF_FALLBACK_MAX_RETRIES=0
# Multilingual (English/Arabic) context indexing only; never used for document generation.
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_EMBEDDING_CHUNK_BYTES=1000
AI_EMBEDDING_TIMEOUT_SECONDS=45
CHATTER_AI_EMBEDDING_MAX_CHUNKS_PER_RUN=4
CHATTER_AI_EMBEDDING_CONCURRENCY=4
AI_SUMMARY_MAX_NEW_SOURCES_PER_RUN=12
AI_SUMMARY_MIN_NEW_SOURCES=3
# Current Groq dashboard limits for the active project. The input/output
# numbers are Datum's conservative per-request budgets, not claimed model maxima.
AI_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
AI_PROMPT_GUARD_SOURCE_BYTES=1000
AI_PROMPT_GUARD_MAX_INPUT_TOKENS=384
AI_PROMPT_GUARD_MAX_OUTPUT_TOKENS=16
AI_PROMPT_GUARD_RPM=30
AI_PROMPT_GUARD_TPM=15000
AI_PROMPT_GUARD_RPD=14400
AI_PROMPT_GUARD_TIMEOUT_SECONDS=30
AI_PROMPT_GUARD_MAX_RETRIES=0
AI_REVIEW_MODEL=qwen/qwen3.8-27b
AI_REVIEW_SOURCE_BYTES=12000
AI_REVIEW_MAX_INPUT_TOKENS=4000
AI_REVIEW_MAX_OUTPUT_TOKENS=750
AI_REVIEW_RPM=30
AI_REVIEW_TPM=8000
AI_REVIEW_RPD=1000
AI_REVIEW_TIMEOUT_SECONDS=90
AI_REVIEW_MAX_RETRIES=1
AI_REVIEW_FALLBACK_ENABLED=true
AI_REVIEW_FALLBACK_MODEL=qwen/qwen3.6-27b
AI_REVIEW_FALLBACK_SOURCE_BYTES=6000
AI_REVIEW_FALLBACK_MAX_INPUT_TOKENS=3000
AI_REVIEW_FALLBACK_MAX_OUTPUT_TOKENS=750
AI_REVIEW_FALLBACK_RPM=30
AI_REVIEW_FALLBACK_TPM=8000
AI_REVIEW_FALLBACK_RPD=1000
AI_REVIEW_FALLBACK_TIMEOUT_SECONDS=90
AI_REVIEW_FALLBACK_MAX_RETRIES=1
AI_SUMMARY_MODEL=qwen/qwen3.6-27b
AI_SUMMARY_SOURCE_BYTES=6000
AI_SUMMARY_MAX_INPUT_TOKENS=2000
AI_SUMMARY_MAX_OUTPUT_TOKENS=256
AI_SUMMARY_RPM=30
AI_SUMMARY_TPM=8000
AI_SUMMARY_RPD=1000
AI_SUMMARY_TIMEOUT_SECONDS=60
AI_SUMMARY_MAX_RETRIES=1
DATUM_ENGINE_API_AUTH_TOKEN=datum_engine
# Required for immediate Chatter replies. Replace the database name.
ODOO_CHATTER_CALLBACK_URL=http://127.0.0.1:8071/datum-engine/chatter-ai/callback?db=your_database
ODOO_RUN_CALLBACK_URL=http://127.0.0.1:8071/datum-engine/run/callback?db=your_database
# Optional; when blank the API auth token is used for HMAC signing.
ODOO_CALLBACK_SIGNING_SECRET=
ODOO_CHATTER_CALLBACK_TIMEOUT_SECONDS=5
TAVILY_API_KEY=


# Absolute path to the externally managed skill registry.
REGISTRY_PATH=C:\path\outside\the\repository\datum-engine-registry
PROMPT_REGISTRY_PATH=C:\ProgramData\OdooTec\datum-engine-prompts

# The worker is in-process, but its jobs and AI session state are durable in
# Neon. Redis is not required.
LOG_LEVEL=INFO
LOG_FORMAT=console
WORKER_CONCURRENCY=2
DEV_OUTPUT_DIR=./.runtime/outputs
ENGINE_STATE_DIR=./.runtime/engine-state
ENGINE_OUTPUT_DIR=./.runtime/engine-outputs
ENGINE_ALLOW_DEMO_OUTPUTS=false
ENGINE_MAX_SOURCE_BYTES=14000
ENGINE_QUALITY_ATTEMPTS=3
ENGINE_SESSION_RETRIEVAL_MAX_SOURCES=24
ENGINE_SESSION_RETRIEVAL_MAX_BYTES=40000
CHATTER_AI_STATE_DIR=./.runtime/chatter-ai-state
CHATTER_AI_GROQ_CONTEXT_BYTES=256
CHATTER_AI_FALLBACK_CONTEXT_BYTES=12000
CHATTER_AI_GROQ_MAX_COMPLETION_TOKENS=256
CHATTER_AI_RETRIEVAL_MAX_SOURCES=40
CHATTER_AI_RETRIEVAL_MAX_BYTES=48000
AI_JOB_LEASE_SECONDS=120
AI_JOB_POLL_SECONDS=1
AI_JOB_MAX_ATTEMPTS=3
ENGINE_DEMO_REGISTRY_PATH=C:\\ProgramData\\OdooTec\\datum-engine-registry
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_FILES=5
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=30
DOCUMENT_EXTRACTION_MAX_PDF_PAGES=100
DOCUMENT_EXTRACTION_MAX_TEXT_BYTES=500000
RUN_MAX_ATTEMPTS=3
REVIEW_LOOP_MAX_CYCLES=5
